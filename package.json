{
	"name": "clickuptool",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"generate:api": "openapi-typescript clickup-user-api.json -o src/lib/api/api.generated.ts",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.3",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"eslint": "^10.0.2",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.51.0",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vite": "^7.3.1"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": "eslint --fix"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.12.0",
		"@lukemorales/query-key-factory": "^1.3.4",
		"@tanstack/svelte-query": "^6.0.18",
		"openapi-fetch": "^0.17.0"
	}
}
